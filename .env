# Global
TZ=Europe/Moscow


# Image versions

# eeacms/rsync
RSYNC_V=3.1
# tailscale/tailscale
TAILSCALE_V=stable
# jnovack/autossh
AUTOSSH_V=2.1.0


# Volume locations

DATA_VOLUME=${HOME}/.local/share

COPYPARTY_DATA=${DATA_VOLUME}/copyparty/
IMMICH_DATA=${DATA_VOLUME}/immich/
VAULTWARDEN_DATA=${DATA_VOLUME}/vaultwarden/
SWINGMUSIC_DATA=${DATA_VOLUME}/swingmusic/
SCRUTINY_DATA=${DATA_VOLUME}/scrutiny/
MEMOS_DATA=${DATA_VOLUME}/memos/
ALCS_DATA=${DATA_VOLUME}/alcs/
PROXIER_DATA=${DATA_VOLUME}/proxier/

LOCAL_BACKUP_VOLUME=/mnt/backup/

BACKUP_COPYPARTY_LOCAL=${LOCAL_BACKUP_VOLUME}/copyparty/
BACKUP_IMMICH_LOCAL=${LOCAL_BACKUP_VOLUME}/immich/
BACKUP_VAULTWARDEN_LOCAL=${LOCAL_BACKUP_VOLUME}/vaultwarden/
BACKUP_SWINGMUSIC_LOCAL=${LOCAL_BACKUP_VOLUME}/swingmusic/
BACKUP_SCRUTINY_LOCAL=${LOCAL_BACKUP_VOLUME}/scrutiny/
BACKUP_MEMOS_LOCAL=${LOCAL_BACKUP_VOLUME}/memos/
BACKUP_PROXIER_LOCAL=${LOCAL_BACKUP_VOLUME}/proxier/


# Immich

IMMICH_UPLOAD_LOCATION=${BACKUP_IMMICH_LOCAL}library
IMMICH_DB_DATA_LOCATION=${IMMICH_DATA}postgres


# "disk-enabled" includes services utilizing HDD
COMPOSE_PROFILES=disk-enabled


# dozzle icons
DOZZLE_ICON_AUTOSSH='data:image/svg+xml;base64,'
